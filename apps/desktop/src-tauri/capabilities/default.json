{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$HOME/.threemaker/maps/**" },
        { "path": "$HOME/.threemaker/input-bindings.json" },
        { "path": "$HOME/.threemaker/saves/current.json" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$HOME/.threemaker/input-bindings.json" },
        { "path": "$HOME/.threemaker/saves/current.json" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$HOME/.threemaker" }, { "path": "$HOME/.threemaker/saves" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$HOME/.threemaker/maps/**" },
        { "path": "$HOME/.threemaker/input-bindings.json" },
        { "path": "$HOME/.threemaker/saves/current.json" }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$HOME/.threemaker/asset-store/**" }]
    },
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$HOME/.threemaker/**" }]
    }
  ]
}
