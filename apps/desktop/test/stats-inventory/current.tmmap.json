      {
        "type": "showDialogue",
        "source": { "kind": "ink", "storyId": "gatekeeper", "knot": "start" }
      }
    ],
    "wound_self": [
      { "type": "modifyStat", "statId": "hp", "delta": -6 },
      {
        "type": "showDialogue",
        "source": { "kind": "text", "lines": ["A sharp pain. Your wounds deepen."] }
      }
    ],
    "vitality_check": [
      {
        "type": "conditional",
        "if": { "key": "hp", "op": "gte", "value": 8, "source": "stat" },
        "then": [
          { "type": "setWorldVar", "key": "fit_to_climb", "value": true },
          {
            "type": "showDialogue",
            "source": { "kind": "text", "lines": ["You feel fit to climb the rope."] }
          }
        ],
        "else": [
          { "type": "setWorldVar", "key": "fit_to_climb", "value": false },
          {
            "type": "showDialogue",
            "source": { "kind": "text", "lines": ["You are too weak to climb the rope."] }
          }
        ]
      }
    ]
  },
  "worldSeeds": { "chest_opened": false }
